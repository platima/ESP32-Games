index 95e1b60..b1a539e 100644
--- a/fbdoom/i_input_tty.c
+++ b/fbdoom/i_input_tty.c
@@ -25,6 +25,7 @@
 #include <fcntl.h>
 #include <stdio.h>
 #include <termios.h>
+#include <signal.h>
 #include <sys/ioctl.h>
 #include <linux/keyboard.h>
 #include <linux/kd.h>
@@ -254,6 +255,28 @@ int tty_is_kbd(int fd)
 static int old_mode = -1;
 static struct termios old_term;
 static int kb = -1; /* keyboard file descriptor */
+static int old_kdmode = -1;
+
+/* Put the VT back: keyboard mode, termios and text mode. */
+static void kbd_restore(void)
+{
+    if (old_mode != -1) {
+        ioctl(kb, KDSKBMODE, old_mode);
+        tcsetattr(kb, TCSANOW, &old_term);
+        old_mode = -1;
+    }
+    if (old_kdmode != -1) {
+        ioctl(kb, KDSETMODE, old_kdmode);
+        old_kdmode = -1;
+    }
+}
+
+static void kbd_fatal(int sig)
+{
+    kbd_restore();
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
 
 void kbd_shutdown(void)
 {
@@ -263,10 +286,7 @@ void kbd_shutdown(void)
     fflush(stdout);
 
     printf("Exiting normally.\n");
-    if (old_mode != -1) {
-        ioctl(kb, KDSKBMODE, old_mode);
-        tcsetattr(kb, 0, &old_term);
-    }
+    kbd_restore();
 
     if (kb > 3)
         close(kb);
@@ -333,6 +353,15 @@ static int kbd_init(void)
         kbd_shutdown();
     }
 
+    atexit(kbd_restore);
+    signal(SIGSEGV, kbd_fatal);
+    signal(SIGBUS, kbd_fatal);
+    signal(SIGILL, kbd_fatal);
+    signal(SIGFPE, kbd_fatal);
+    signal(SIGABRT, kbd_fatal);
+    signal(SIGTERM, kbd_fatal);
+    signal(SIGHUP, kbd_fatal);
+
     new_term = old_term;
     new_term.c_iflag = 0;
     new_term.c_lflag &= ~(ECHO | ICANON | ISIG);
@@ -349,6 +378,12 @@ static int kbd_init(void)
         kbd_shutdown();
     }
 
+    /* Stop fbcon drawing its cursor and messages over the game. */
+    if (ioctl(kb, KDGETMODE, &old_kdmode) != 0)
+        old_kdmode = -1;
+    else
+        ioctl(kb, KDSETMODE, KD_GRAPHICS);
+
     /* Put in non-blocking mode */
     flags = fcntl(kb, F_GETFL, 0);
     fcntl(kb, F_SETFL, flags | O_NONBLOCK);
