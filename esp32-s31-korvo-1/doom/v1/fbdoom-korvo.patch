index c6e5925..5ddf6ba 100644
--- a/fbdoom/i_video_fbdev.c
+++ b/fbdoom/i_video_fbdev.c
@@ -47,6 +47,7 @@ rcsid[] = "$Id: i_x.c,v 1.6 1997/02/03 22:45:10 b1 Exp $";
 #include <sys/socket.h>
 #include <linux/fb.h>
 #include <sys/ioctl.h>
+#include <sys/mman.h>
 
 //#define CMAP256
 
@@ -63,6 +64,55 @@ struct color {
 
 static struct color colors[256];
 
+/* 16 bpp fast path: the mapped frame buffer and a palette with each
+ * pixel in both halves of a word, so 2x scaling is one store. */
+static struct fb_fix_screeninfo fix;
+static byte *fb_mem = NULL;
+static uint32_t pal16[256];
+static int pal16_dirty = 1;
+
+static int blit16_ok(int *xo, int *yo)
+{
+    *xo = ((int)fb.xres - SCREENWIDTH * fb_scaling) / 2;
+    *yo = ((int)fb.yres - SCREENHEIGHT * fb_scaling) / 2;
+    return fb_mem != NULL && fb.bits_per_pixel == 16 && fb_scaling >= 1
+        && *xo >= 0 && *yo >= 0 && (fix.line_length & 3) == 0;
+}
+
+static void blit16(int xo, int yo)
+{
+    const byte *in = I_VideoBuffer;
+    int x, y, k;
+
+    if (pal16_dirty) {
+        for (x = 0; x < 256; x++) {
+            uint32_t v = ((uint32_t)(colors[x].r >> (8 - fb.red.length)) << fb.red.offset)
+                       | ((uint32_t)(colors[x].g >> (8 - fb.green.length)) << fb.green.offset)
+                       | ((uint32_t)(colors[x].b >> (8 - fb.blue.length)) << fb.blue.offset);
+            pal16[x] = (v & 0xffff) | (v << 16);
+        }
+        pal16_dirty = 0;
+    }
+
+    for (y = 0; y < SCREENHEIGHT; y++, in += SCREENWIDTH) {
+        byte *row = fb_mem + (yo + y * fb_scaling) * fix.line_length + xo * 2;
+
+        if (fb_scaling == 2 && (xo & 1) == 0) {
+            uint32_t *r0 = (uint32_t *)row;
+            uint32_t *r1 = (uint32_t *)(row + fix.line_length);
+            for (x = 0; x < SCREENWIDTH; x++)
+                r0[x] = r1[x] = pal16[in[x]];
+        } else {
+            uint16_t *o = (uint16_t *)row;
+            for (x = 0; x < SCREENWIDTH; x++)
+                for (k = 0; k < fb_scaling; k++)
+                    *o++ = (uint16_t)pal16[in[x]];
+            for (k = 1; k < fb_scaling; k++)
+                memcpy(row + k * fix.line_length, row, SCREENWIDTH * fb_scaling * 2);
+        }
+    }
+}
+
 // The screen buffer; this is modified to draw things to the screen
 
 byte *I_VideoBuffer = NULL;
@@ -196,6 +246,15 @@ void I_InitGraphics (void)
     }
 
 
+    /* Map the frame buffer; fall back to write() if that fails */
+    if (ioctl(fd_fb, FBIOGET_FSCREENINFO, &fix) == 0 && fix.smem_len != 0) {
+        fb_mem = mmap(NULL, fix.smem_len, PROT_READ | PROT_WRITE, MAP_SHARED, fd_fb, 0);
+        if (fb_mem == MAP_FAILED)
+            fb_mem = NULL;
+    }
+    puts(fb_mem ? "I_InitGraphics: mmap, 16 bpp fast path if it fits"
+                : "I_InitGraphics: write() path");
+
     /* Allocate screen to draw to */
 	I_VideoBuffer = (byte*)Z_Malloc (SCREENWIDTH * SCREENHEIGHT, PU_STATIC, NULL);  // For DOOM to draw on
 	I_VideoBuffer_FB = (byte*)malloc(fb.xres * fb.yres * (fb.bits_per_pixel/8));     // For a single write() syscall to fbdev
@@ -204,6 +263,11 @@ void I_InitGraphics (void)
 
