diff --git a/fbdoom/i_input_evdev_mouse.c b/fbdoom/i_input_evdev_mouse.c
new file mode 100644
index 0000000..0aa03ce
--- /dev/null
+++ b/fbdoom/i_input_evdev_mouse.c
@@ -0,0 +1,280 @@
+//
+// This program is free software; you can redistribute it and/or
+// modify it under the terms of the GNU General Public License
+// as published by the Free Software Foundation; either version 2
+// of the License, or (at your option) any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// DESCRIPTION:
+//	DOOM mouse input via linux evdev
+//
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <linux/input.h>
+
+#include "doomtype.h"
+#include "d_event.h"
+#include "i_input_tty.h"
+#include "m_argv.h"
+
+#define MAX_MICE 4
+
+/* Movement that has been read but not posted yet is kept within this.  It
+ * is far more than a mouse sends between two tics, and it keeps the sums
+ * and the acceleration from overflowing whatever a device reports. */
+#define MOUSE_MAX 0x7fff
+
+/* An event as the kernel writes it: the time as two longs, then the type,
+ * the code and the value.  struct input_event from <linux/input.h> is not
+ * used for reading.  With a 64-bit time_t on a 32-bit system it is only
+ * the same size if the C library defines __USE_TIME_BITS64 before that
+ * header is read; if not, it is 24 bytes and the kernel writes 16. */
+struct kernel_input_event {
+    unsigned long sec;
+    unsigned long usec;
+    uint16_t type;
+    uint16_t code;
+    int32_t value;
+};
+
+_Static_assert(sizeof(struct kernel_input_event) == (sizeof(long) == 4 ? 16 : 24),
+               "struct kernel_input_event does not match the kernel");
+
+static struct mouse {
+    int fd;
+    int buttons;    /* bit 0 left, bit 1 right, bit 2 middle */
+    int have;       /* bytes of an unfinished event left by the last read */
+    unsigned char buf[16 * sizeof(struct kernel_input_event)];
+} mice[MAX_MICE];
+
+static int nmice = 0;
+static int novert = 0;
+static int mouse_dx = 0, mouse_dy = 0;  /* movement read, not posted yet */
+
+/* The kernel's bitmaps are arrays of unsigned long. */
+#define LONG_BITS       (8 * sizeof(unsigned long))
+#define BITMAP_LONGS(n) (((n) + LONG_BITS - 1) / LONG_BITS)
+
+static int test_bit(const unsigned long *map, int n)
+{
+    return (map[n / LONG_BITS] >> (n % LONG_BITS)) & 1;
+}
+
+/* A mouse reports relative X and Y and has a left button. */
+static int is_mouse(int fd)
+{
+    unsigned long ev[BITMAP_LONGS(EV_CNT)] = { 0 };
+    unsigned long rel[BITMAP_LONGS(REL_CNT)] = { 0 };
+    unsigned long key[BITMAP_LONGS(KEY_CNT)] = { 0 };
+
+    if (ioctl(fd, EVIOCGBIT(0, sizeof(ev)), ev) < 0
+        || !test_bit(ev, EV_REL) || !test_bit(ev, EV_KEY))
+        return 0;
+    if (ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel)), rel) < 0
+        || ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(key)), key) < 0)
+        return 0;
+
+    return test_bit(rel, REL_X) && test_bit(rel, REL_Y) && test_bit(key, BTN_LEFT);
+}
+
+/* Start reading a mouse from an open, non-blocking descriptor. */
+static int mouse_add(int fd)
+{
+    if (nmice >= MAX_MICE)
+        return 0;
+
+    mice[nmice].fd = fd;
+    mice[nmice].buttons = 0;
+    mice[nmice].have = 0;
+    nmice++;
+    return 1;
+}
+
+/* The kernel dropped events, so a button change may be missing: ask
+ * which buttons are down now. */
+static void mouse_sync(struct mouse *m)
+{
+    unsigned long key[BITMAP_LONGS(KEY_CNT)] = { 0 };
+
+    m->buttons = 0;
+    if (ioctl(m->fd, EVIOCGKEY(sizeof(key)), key) >= 0)
+        m->buttons = test_bit(key, BTN_LEFT) | (test_bit(key, BTN_RIGHT) << 1)
+                   | (test_bit(key, BTN_MIDDLE) << 2);
+}
+
+/* Add to a movement total, staying within MOUSE_MAX either way. */
+static int mouse_move(int total, int value)
+{
+    if (value > MOUSE_MAX)
+        value = MOUSE_MAX;
+    else if (value < -MOUSE_MAX)
+        value = -MOUSE_MAX;
+
+    total += value;
+
+    if (total > MOUSE_MAX)
+        total = MOUSE_MAX;
+    else if (total < -MOUSE_MAX)
+        total = -MOUSE_MAX;
+
+    return total;
+}
+
+static void mouse_event(struct mouse *m, const struct kernel_input_event *ev)
+{
+    int bit;
+
+    if (ev->type == EV_REL) {
+        if (ev->code == REL_X)
+            mouse_dx = mouse_move(mouse_dx, ev->value);
+        else if (ev->code == REL_Y)
+            mouse_dy = mouse_move(mouse_dy, ev->value);
+    } else if (ev->type == EV_KEY) {
+        switch (ev->code) {
+            case BTN_LEFT:   bit = 1; break;
+            case BTN_RIGHT:  bit = 2; break;
+            case BTN_MIDDLE: bit = 4; break;
+            default: return;
+        }
+        if (ev->value)
+            m->buttons |= bit;
+        else
+            m->buttons &= ~bit;
+    } else if (ev->type == EV_SYN && ev->code == SYN_DROPPED) {
+        mouse_sync(m);
+    }
+}
+
+/* Read everything that is waiting on one mouse, without blocking.
+ * Returns 0 if the mouse has gone (unplugged, for example). */
+static int mouse_drain(struct mouse *m)
+{
+    struct kernel_input_event ev;
+    int n, off, room;
+
+    for (;;) {
+        room = sizeof(m->buf) - m->have;
+        n = read(m->fd, m->buf + m->have, room);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n < 0 && errno == EAGAIN)
+            return 1;
+        if (n <= 0)
+            return 0;
+
+        /* Handle the whole events, and keep the start of an unfinished
+         * one for the next read. */
+        m->have += n;
+        for (off = 0; off + (int)sizeof(ev) <= m->have; off += sizeof(ev)) {
+            memcpy(&ev, m->buf + off, sizeof(ev));
+            mouse_event(m, &ev);
+        }
+        m->have -= off;
+        memmove(m->buf, m->buf + off, m->have);
+
+        /* A read that did not fill the buffer took all there was. */
+        if (n < room)
+            return 1;
+    }
+}
+
+/* Chocolate Doom's default mouse acceleration (threshold 10, factor 2) in
+ * integer maths: movement beyond 10 counts is doubled. */
+static int mouse_accel(int val)
+{
+    if (val > 10)
+        return (val - 10) * 2 + 10;
+    if (val < -10)
+        return (val + 10) * 2 - 10;
+
+    return val;
+}
+
+/* Read what is waiting on every mouse, and keep it for I_ReadMouse.  The
+ * kernel only holds a small number of events for each device (128 for an
+ * ordinary mouse) and throws away the lot when that fills up, so this is
+ * also called on either side of the blit in i_video_fbdev.c, which is the
+ * longest stretch with no call to I_GetEvent. */
+void I_PollMouse(void)
+{
+    int i;
+
+    for (i = 0; i < nmice; i++) {
+        if (!mouse_drain(&mice[i])) {
+            close(mice[i].fd);
+            mice[i] = mice[--nmice];
+            i--;
+        }
+    }
+}
+
+/* Called from I_GetEvent.  Posts at most one ev_mouse event, holding all
+ * the movement since the last one and the buttons as they are now. */
+void I_ReadMouse(void)
+{
+    static int last_buttons = 0;
+    int i, buttons = 0;
+    event_t event;
+
+    I_PollMouse();
+
+    for (i = 0; i < nmice; i++)
+        buttons |= mice[i].buttons;
+
+    if (mouse_dx == 0 && mouse_dy == 0 && buttons == last_buttons)
+        return;
+    last_buttons = buttons;
+
+    event.type = ev_mouse;
+    event.data1 = buttons;
+    event.data2 = mouse_accel(mouse_dx);
+    event.data3 = novert ? 0 : -mouse_accel(mouse_dy);
+    event.data4 = 0;
+    mouse_dx = mouse_dy = 0;
+    D_PostEvent(&event);
+}
+
+/* Find the mice among /dev/input/event0 to event31.  The use_mouse
+ * config variable is not looked at: -nomouse turns the mouse off. */
+void I_InitMouse(void)
+{
+    char path[32];
+    char name[64];
+    int i, fd;
+
+    novert = M_CheckParm("-novert") > 0;
+
+    if (M_CheckParm("-nomouse") > 0)
+        return;
+
+    for (i = 0; i < 32 && nmice < MAX_MICE; i++) {
+        snprintf(path, sizeof(path), "/dev/input/event%d", i);
+        fd = open(path, O_RDONLY | O_NONBLOCK);
+        if (fd < 0)
+            continue;
+        if (!is_mouse(fd)) {
+            close(fd);
+            continue;
+        }
+
+        memset(name, 0, sizeof(name));
+        if (ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name) < 0)
+            strcpy(name, "?");
+        printf("Using mouse on %s (%s)\n", path, name);
+        mouse_add(fd);
+    }
+
+    if (nmice == 0)
+        printf("No mouse found.\n");
+}
