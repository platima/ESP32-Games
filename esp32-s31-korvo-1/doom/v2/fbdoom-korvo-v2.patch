+static int fb_fits(int x, int y, int w, int h)
+{
+    return fb_mem != NULL && fb.bits_per_pixel == 16
+        && ((uintptr_t)fb_mem & 3) == 0 && (fix.line_length & 1) == 0
+        && x >= 0 && y >= 0 && w > 0 && h > 0
+        && x + w <= (int)fb.xres && y + h <= (int)fb.yres
+        && (uint32_t)(x + w) * 2 <= fix.line_length
+        && (uint64_t)(y + h - 1) * fix.line_length + (x + w) * 2 <= fix.smem_len;
+}
+
+static void pal16_update(void)
+{
+    int x;
+
+    for (x = 0; x < 256; x++) {
+        uint32_t v = ((uint32_t)(colors[x].r >> (8 - fb.red.length)) << fb.red.offset)
+                   | ((uint32_t)(colors[x].g >> (8 - fb.green.length)) << fb.green.offset)
+                   | ((uint32_t)(colors[x].b >> (8 - fb.blue.length)) << fb.blue.offset);
+        pal16[x] = (v & 0xffff) | (v << 16);
+    }
+    pal16_dirty = 0;
+}
+
+/* Integer scaling, centred. */
+static void blit16(int xo, int yo)
+{
+    const byte *in = I_VideoBuffer;
+    int x, y, k;
+
+    for (y = 0; y < SCREENHEIGHT; y++, in += SCREENWIDTH) {
+        byte *row = fb_mem + (yo + y * fb_scaling) * fix.line_length + xo * 2;
+
+        if (fb_scaling == 2 && (xo & 1) == 0) {
+            uint32_t *r0 = (uint32_t *)row;
+            uint32_t *r1 = (uint32_t *)(row + fix.line_length);
+            for (x = 0; x < SCREENWIDTH; x++)
+                r0[x] = r1[x] = pal16[in[x]];
+        } else {
+            uint16_t *o = (uint16_t *)row;
+            for (x = 0; x < SCREENWIDTH; x++)
+                for (k = 0; k < fb_scaling; k++)
+                    *o++ = (uint16_t)pal16[in[x]];
+            for (k = 1; k < fb_scaling; k++)
+                memcpy(row + k * fix.line_length, row, SCREENWIDTH * fb_scaling * 2);
+        }
+    }
+}
+
+/* Two pixels in one aligned 32-bit store: the first from the palette
+ * entry a, the second from b. */
+#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define PAL16_PAIR(a, b) (((a) & 0xffff) | ((b) & 0xffff0000))
+#else
+#define PAL16_PAIR(a, b) (((a) & 0xffff0000) | ((b) & 0xffff))
+#endif
+
+/* The row loops of the general scaler, for when everything is word
+ * aligned.  Each writes one source row to n destination rows at once, two
+ * pixels to a store, so that the rows need not be read back to be copied.
+ * n is 1, 2 or 3, and a constant wherever they are called, which takes the
+ * tests on it out of the loops.  There is always at least one store to do. */
+#define ROW_LOOP static inline __attribute__((always_inline)) void
+
+/* Any width: through xmap. */
+ROW_LOOP row16_any(byte *row, int line, const byte *in, int w, int n)
+{
+    uint32_t *o0 = (uint32_t *)row;
+    uint32_t *o1 = (uint32_t *)(row + (n > 1 ? line : 0));
+    uint32_t *o2 = (uint32_t *)(row + (n > 2 ? 2 * line : 0));
+    const uint16_t *xm = xmap, *end = xmap + w;
+
+    do {
+        uint32_t v = PAL16_PAIR(pal16[in[xm[0]]], pal16[in[xm[1]]]);
+
+        *o0++ = v;
+        if (n > 1)
+            *o1++ = v;
+        if (n > 2)
+            *o2++ = v;
+        xm += 2;
+    } while (xm != end);
+}
+
+/* Twice the width (320 to 640): each source pixel is one store. */
+ROW_LOOP row16_2x(byte *row, int line, const byte *in, int n)
+{
+    uint32_t *o0 = (uint32_t *)row;
+    uint32_t *o1 = (uint32_t *)(row + (n > 1 ? line : 0));
+    uint32_t *o2 = (uint32_t *)(row + (n > 2 ? 2 * line : 0));
+    int x = 0;
+
+    do {
+        uint32_t v = pal16[in[x]];
+
+        o0[x] = v;
+        if (n > 1)
+            o1[x] = v;
+        if (n > 2)
+            o2[x] = v;
+    } while (++x < SCREENWIDTH);
+}
+
+/* Two and a half times the width (320 to 800): the source pixels a b c d
+ * become a a b b b c c d d d, which is five stores. */
+#define PUT5(o) ((o)[0] = a, (o)[1] = b, (o)[2] = bc, (o)[3] = cd, (o)[4] = d, (o) += 5)
+
+ROW_LOOP row16_5_2(byte *row, int line, const byte *in, int n)
+{
+    uint32_t *o0 = (uint32_t *)row;
+    uint32_t *o1 = (uint32_t *)(row + (n > 1 ? line : 0));
+    uint32_t *o2 = (uint32_t *)(row + (n > 2 ? 2 * line : 0));
+    const byte *end = in + SCREENWIDTH;
+
+    do {
+        uint32_t a = pal16[in[0]], b = pal16[in[1]];
+        uint32_t c = pal16[in[2]], d = pal16[in[3]];
+        uint32_t bc = PAL16_PAIR(b, c), cd = PAL16_PAIR(c, d);
+
+        PUT5(o0);
+        if (n > 1)
+            PUT5(o1);
+        if (n > 2)
+            PUT5(o2);
+        in += 4;
+    } while (in != end);
+}
+
+/* One source row to n destination rows, by the loop that suits the width. */
+ROW_LOOP rows16(byte *row, int line, const byte *in, int w, int n)
+{
+    if (xpat == XPAT_5_2)
+        row16_5_2(row, line, in, n);
+    else if (xpat == XPAT_2X)
+        row16_2x(row, line, in, n);
+    else
+        row16_any(row, line, in, w, n);
+}
+
+/* Which row loop suits the columns in xmap.  A special one is only chosen
+ * when every entry of xmap agrees with it, so that it draws exactly what
+ * the loop through xmap would. */
+static int xmap_pattern(int w)
+{
+    int is_2x = w == SCREENWIDTH * 2;
+    int is_5_2 = w * 2 == SCREENWIDTH * 5 && SCREENWIDTH % 4 == 0;
+    int i;
+
+    for (i = 0; i < w; i++) {
+        if (xmap[i] != i / 2)
+            is_2x = 0;
+        if (xmap[i] != i / 5 * 2 + (i % 5 >= 2))
+            is_5_2 = 0;
+    }
+    return is_2x ? XPAT_2X : is_5_2 ? XPAT_5_2 : XPAT_ANY;
+}
+
+/* Any size, up or down: nearest neighbour through xmap and ymap, straight
+ * into the mapping.  Each source row is built once, and copied to the other
+ * destination rows that show it. */
+static void blit16_scaled(void)
+{
+    const int line = fix.line_length, w = dst_w;
+    byte *row = fb_mem + dst_y * line + dst_x * 2;
+    int pairs = ((uintptr_t)row & 3) == 0 && (line & 3) == 0 && (w & 1) == 0;
+    int x, y, n, k;
+
+    for (y = 0; y < dst_h; y += n, row += n * line) {
+        const byte *in = I_VideoBuffer + ymap[y] * SCREENWIDTH;
+
+        /* n destination rows show this source row */
+        for (n = 1; y + n < dst_h && ymap[y + n] == ymap[y]; n++)
+            ;
+
+        if (pairs) {
+            /* Up to three rows are written at once, as the 2x path does;
+             * any more are copied below. */
+            k = n < 3 ? n : 3;
+            if (k == 1)
+                rows16(row, line, in, w, 1);
+            else if (k == 2)
+                rows16(row, line, in, w, 2);
+            else
+                rows16(row, line, in, w, 3);
+        } else {
+            uint16_t *o = (uint16_t *)row;
+
+            for (x = 0; x < w; x++)
+                o[x] = (uint16_t)pal16[in[xmap[x]]];
+            k = 1;
+        }
+
+        for (; k < n; k++)
+            memcpy(row + k * line, row, w * 2);
+    }
+}
+
+/* Choose how the picture is put on the screen.  -scaling N keeps integer
+ * scaling.  Otherwise the general scaler fills the screen, or with -aspect
+ * the largest 4:3 rectangle that fits.  Whatever the general scaler cannot
+ * do is left to integer scaling. */
+static void blit_select(void)
+{
+    int fixed = M_CheckParmWithArgs("-scaling", 1) > 0;
+    int fit = fb.xres / SCREENWIDTH;
+    int w = fb.xres, h = fb.yres, i;
+    const char *how = "fill";
+
+    if (fb.yres / SCREENHEIGHT < fit)
+        fit = fb.yres / SCREENHEIGHT;
+
+    /* A factor that does not fit would run off the end of the buffers. */
+    if (fixed && (fb_scaling < 1 || fb_scaling > fit)) {
+        printf("I_InitGraphics: scaling factor %d does not fit, ignored\n", fb_scaling);
+        fb_scaling = fit;
+        fixed = 0;
+    }
+
+    if (!fixed) {
+        if (M_CheckParm("-aspect") > 0) {
+            how = "aspect";
+            if (w * 3 > h * 4)
+                w = h * 4 / 3;
+            else
+                h = w * 3 / 4;
+        }
+        dst_x = ((int)fb.xres - w) / 2;
+        dst_y = ((int)fb.yres - h) / 2;
+
+        if (fb_fits(dst_x, dst_y, w, h)) {
+            xmap = malloc(w * sizeof(*xmap));
+            ymap = malloc(h * sizeof(*ymap));
+        }
+        if (xmap != NULL && ymap != NULL) {
+            /* Sample the source at the centre of each destination pixel. */
+            for (i = 0; i < w; i++)
+                xmap[i] = ((2 * i + 1) * SCREENWIDTH) / (2 * w);
+            for (i = 0; i < h; i++)
+                ymap[i] = ((2 * i + 1) * SCREENHEIGHT) / (2 * h);
+            xpat = xmap_pattern(w);
+            blit_mode = BLIT_SCALED;
+        } else {
+            free(xmap);
+            free(ymap);
+            xmap = ymap = NULL;
+        }
+    }
+
+    if (blit_mode != BLIT_SCALED) {
+        /* Integer scaling cannot make the picture smaller, and would
+         * leave the screen black.  The VT is still in text mode here. */
+        if (fb_scaling < 1)
+            I_Error("I_InitGraphics: the screen is smaller than %dx%d, and the "
+                    "picture can only be scaled down in a mapped 16 bpp frame buffer",
+                    SCREENWIDTH, SCREENHEIGHT);
+
+        w = SCREENWIDTH * fb_scaling;
+        h = SCREENHEIGHT * fb_scaling;
+        dst_x = ((int)fb.xres - w) / 2;
+        dst_y = ((int)fb.yres - h) / 2;
+        if (fb_scaling >= 1 && (fix.line_length & 3) == 0 && fb_fits(dst_x, dst_y, w, h))
+            blit_mode = BLIT_INTEGER;
+        how = blit_mode == BLIT_INTEGER ? "integer" : "integer, write() path";
+    }
+    dst_w = w;
+    dst_h = h;
+
+    printf("I_InitGraphics: %dx%d -> %dx%d at (%d,%d), %s\n",
+            SCREENWIDTH, SCREENHEIGHT, dst_w, dst_h, dst_x, dst_y, how);
+}
+
+static uint32_t fps_ms(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint32_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/* The number for -showfps.  Its digits are worked out here, once a second,
+ * and not for every frame. */
+static void fps_set(int fps)
+{
+    fps_shown = fps;
+    fps_cols = snprintf(fps_digits, sizeof(fps_digits), "%d", fps > 999 ? 999 : fps) * 4 + 1;
+}
+
+/* Call when a frame has been presented.  A rate is the frames after the
+ * first one over the time since the first one, so the clock starts when
+ * the first frame is done. */
+static void fps_frame(void)
+{
+    uint32_t ms;
+
+    fps_last = fps_ms();
+    if (++fps_frames == 1) {
+        fps_first = fps_mark = fps_last;
+        fps_mark_frames = 1;
+    }
+
+    ms = fps_last - fps_mark;
+    if (ms >= 1000) {
+        fps_set(((fps_frames - fps_mark_frames) * 1000 + ms / 2) / ms);
+        fps_mark = fps_last;
+        fps_mark_frames = fps_frames;
+    }
+}
+
+/* Registered with atexit() before i_input_tty.c registers its own handler,
+ * so it runs after that one has put the VT back in text mode. */
+static void fps_report(void)
+{
+    uint32_t ms = fps_last - fps_first;
+    unsigned int tenths, fps10;
+
+    if (fps_frames == 0)
+        return;
+    if (fps_frames == 1 || ms == 0) {
+        /* no time between frames to work out a rate from */
+        fprintf(stderr, "fbdoom: %u frame%s\n", fps_frames, fps_frames == 1 ? "" : "s");
+        return;
+    }
+    tenths = (ms + 50) / 100;
+    fps10 = ((uint64_t)(fps_frames - 1) * 10000 + ms / 2) / ms;
+    fprintf(stderr, "fbdoom: %u frames in %u.%u s (%u.%u fps)\n", fps_frames,
+            tenths / 10, tenths % 10, fps10 / 10, fps10 % 10);
+}
+
+/* 3x5 digits, one bit per pixel, top row first. */
+static const uint16_t fps_font[10] = {
+    0x7b6f, 0x2c97, 0x73e7, 0x73cf, 0x5bc9, 0x79cf, 0x79ef, 0x7249, 0x7bef, 0x7bcf
+};
+
+/* -showfps: white digits on a black box in the bottom right corner of the
+ * picture, drawn into the mapping after the blit.  The bottom rows are the
+ * last ones the blit writes, so the box is put back almost at once. */
+static void fps_draw(void)
+{
+    const char *digits = fps_digits;
+    int cols = fps_cols, s, cx, cy, i, j;
+    uint16_t white, v;
+    byte *box;
+
+    if (fps_shown < 0)
+        return;
+
+    /* The size of one font pixel: big enough to read on 800x480, and
+     * small enough for the box to stay inside the picture. */
+    s = dst_h / 96;
+    if (s < 1)
+        s = 1;
+    if (s > dst_w / cols)
+        s = dst_w / cols;
+    if (s < 1 || 7 * s > dst_h)
+        return;
+
+    white = (((1 << fb.red.length) - 1) << fb.red.offset)
+          | (((1 << fb.green.length) - 1) << fb.green.offset)
+          | (((1 << fb.blue.length) - 1) << fb.blue.offset);
+    box = fb_mem + (dst_y + dst_h - 7 * s) * fix.line_length
+        + (dst_x + dst_w - cols * s) * 2;
+
+    /* One column of padding, then three columns and a gap for each digit;
+     * one row of padding above and below the five rows. */
+    for (cy = 0; cy < 7; cy++) {
+        for (cx = 0; cx < cols; cx++) {
+            v = 0;
+            if (cy >= 1 && cy <= 5 && (cx & 3) != 0
+                && ((fps_font[digits[cx / 4] - '0'] >> (18 - cy * 3 - (cx & 3))) & 1))
+                v = white;
+            for (j = 0; j < s; j++) {
+                uint16_t *o = (uint16_t *)(box + (cy * s + j) * fix.line_length) + cx * s;
+                for (i = 0; i < s; i++)
+                    o[i] = v;
+            }
+        }
+    }
+}
