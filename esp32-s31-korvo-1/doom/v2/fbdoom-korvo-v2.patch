+/* Put the VT back: keyboard mode, termios and text mode. */
+void kbd_restore(void)
+{
+    if (old_mode != -1) {
+        ioctl(kb, KDSKBMODE, old_mode);
+        /* Drop the raw key bytes that were never read, or the shell
+           would get them as typed characters. */
+        tcflush(kb, TCIFLUSH);
+        tcsetattr(kb, TCSANOW, &old_term);
+        old_mode = -1;
+    }
+    if (old_kdmode != -1) {
+        ioctl(kb, KDSETMODE, old_kdmode);
+        old_kdmode = -1;
+    }
+}
+
+static void kbd_fatal(int sig)
+{
+    kbd_restore();
+    signal(sig, SIG_DFL);
+    raise(sig);
