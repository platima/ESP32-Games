+				unsynced = 0;
+				count.sync_us += t1 - t0;
+				count.syncs++;
+				aside += t1 - t0;
+			}
+		}
+	}
+
+	/* the screen back in text mode first; finish() does the rest, as it
+	   does for every other way out */
+	text_mode();
+	return 0;
+}
