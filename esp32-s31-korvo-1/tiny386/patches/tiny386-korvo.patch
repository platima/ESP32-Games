+			if (gap < min_gap)
+				gap = min_gap;
+			if (gap > 2000000)
+				gap = 2000000;
+			next_draw = t1 + gap;
+			count.draw_us += cost;
+			count.draws++;
+			if (cost > count.draw_max)
+				count.draw_max = cost;
+			aside += cost;
+		}
