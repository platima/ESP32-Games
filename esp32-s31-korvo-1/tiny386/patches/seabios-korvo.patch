+// Note in the BIOS data area that drive floppyid, of type ftype, has
+// media of type stype
+static void
+floppy_set_media_state(u8 floppyid, u8 ftype, u8 stype)
+{
+    u8 data_rate = GET_GLOBAL(FloppyInfo[stype].data_rate);
+    u8 old_data_rate = GET_BDA(floppy_media_state[floppyid]) >> 6;
+    SET_BDA(floppy_last_data_rate, (old_data_rate<<2) | (data_rate<<6));
+    u8 media = (stype == 1 ? 0x04 : (stype == 2 ? 0x05 : 0x07));
+    u8 fms = (data_rate<<6) | FMS_MEDIA_DRIVE_ESTABLISHED | media;
+    if (GET_GLOBAL(FloppyInfo[stype].chs.cylinder)
+        < GET_GLOBAL(FloppyInfo[ftype].chs.cylinder))
+        fms |= FMS_DOUBLE_STEPPING;
+    SET_BDA(floppy_media_state[floppyid], fms);
+}
+
+// Set the media for a format (int 13h AH=18h): one the drive takes, with
+// the given cylinders and sectors a track
+int
+floppy_set_media_type(struct drive_s *drive_gf, u16 cylinders, u8 sectors)
+{
+    u8 ftype = GET_GLOBALFLAT(drive_gf->floppy_type), stype;
+    if (!ftype || ftype >= ARRAY_SIZE(FloppyInfo))
+        return DISK_RET_EBADTRACK;
+    for (stype=1; stype < ARRAY_SIZE(FloppyInfo); stype++)
+        if (GET_GLOBAL(FloppyInfo[stype].chs.cylinder) == cylinders
+            && GET_GLOBAL(FloppyInfo[stype].chs.sector) == sectors
+            && (GET_GLOBAL(FloppyInfo[stype].floppy_size)
+                == GET_GLOBAL(FloppyInfo[ftype].floppy_size))
+            && (GET_GLOBAL(FloppyInfo[stype].chs.head)
+                <= GET_GLOBAL(FloppyInfo[ftype].chs.head))
+            && cylinders <= GET_GLOBAL(FloppyInfo[ftype].chs.cylinder)
+            && sectors <= GET_GLOBAL(FloppyInfo[ftype].chs.sector))
+            break;
+    if (stype >= ARRAY_SIZE(FloppyInfo))
+        return DISK_RET_EBADTRACK;
+    floppy_set_media_state(GET_GLOBALFLAT(drive_gf->cntl_id), ftype, stype);
+    return DISK_RET_SUCCESS;
+}
+
