+// set media type for format
+static void
+floppy_1318(struct bregs *regs, struct drive_s *drive_fl)
+{
+    u16 cylinders = (regs->ch | ((regs->cl & 0xc0) << 2)) + 1;
+    int status = floppy_set_media_type(drive_fl, cylinders, regs->cl & 0x3f);
+    if (status == DISK_RET_SUCCESS) {
+        // set es & di to point to 11 byte diskette param table in ROM
+        regs->es = SEG_BIOS;
+        regs->di = (u32)&diskette_param_table2;
+    }
+    disk_ret(regs, status);
+}
+
