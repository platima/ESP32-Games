+// Number of pages that fit in video memory in the given mode
+int
+vga_page_count(struct vgamode_s *vmode_g)
+{
+    u8 memmodel = GET_GLOBAL(vmode_g->memmodel);
+    if (memmodel != MM_TEXT && memmodel != MM_PLANAR)
+        return 1;
+    u32 size = memmodel == MM_TEXT ? 32*1024 : 64*1024;
+    u16 pagesize = GET_BDA(video_pagesize);
+    if (!pagesize || pagesize > size)
+        return 1;
+    int pages = size / pagesize;
+    return pages > 8 ? 8 : pages;
+}
