diff --git a/wl_fbcon.cpp b/wl_fbcon.cpp
new file mode 100644
index 0000000..7a3eae9
--- /dev/null
+++ b/wl_fbcon.cpp
@@ -0,0 +1,523 @@
+// WL_FBCON.CPP
+//
+// Running on the Linux frame buffer console.
+//
+// There the screen the game draws on is also the terminal it was started
+// from.  SDL puts that terminal in graphics mode and its keyboard in raw
+// mode, and puts both back when the game ends.  Three things follow:
+//
+//  * Whatever is printed while the game runs is lost, or lands on top of
+//    the last line: in graphics mode the console does not scroll.  So
+//    messages are kept until the end (FBC_Note), and the terminal is put
+//    back first when the game is about to print an error (FBC_TextMode).
+//
+//  * If the game ends in a way that SDL cannot catch (SIGKILL, which is
+//    what the kernel sends a process when memory runs out), nothing puts
+//    the terminal back, and with no other way into the machine that takes
+//    a reboot.  So a second small process waits for the game to end and
+//    then looks at the terminal (the console guard).
+//
+//  * --fix-console does by hand what the guard does, from another login.
+//
+// None of this does anything when the game is not on a console: every step
+// begins by asking the terminal whether it is one.
+
+#include "wl_def.h"
+#include "wl_fbcon.h"
+
+#if defined(__linux__)
+
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <sched.h>
+#include <termios.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <linux/kd.h>
+#include <linux/vt.h>
+
+/*
+=============================================================================
+
+                        MESSAGES KEPT FOR THE END
+
+=============================================================================
+*/
+
+static char     notes[1024];
+static size_t   noteslen;
+
+void FBC_Note(const char *format, ...)
+{
+    va_list vlist;
+    int     len;
+
+    if(noteslen >= sizeof(notes) - 1)
+        return;
+
+    va_start(vlist, format);
+    len = vsnprintf(notes + noteslen, sizeof(notes) - noteslen, format, vlist);
+    va_end(vlist);
+
+    if(len > 0)
+    {
+        noteslen += len;
+        if(noteslen > sizeof(notes) - 1)
+            noteslen = sizeof(notes) - 1;
+    }
+}
+
+/*
+=============================================================================
+
+                             FRAME COUNT
+
+=============================================================================
+*/
+
+static unsigned frames;         // every frame of the 3D view
+static unsigned timedframes;    // those that followed another within a second
+static uint32_t timedms;        // and the time between them
+static uint32_t lastframe;      // in ms, from SDL_GetTicks
+
+//
+// A frame that follows the one before it within a second counts towards the
+// frame rate.  A longer gap is not drawing time: a menu was up, or a level
+// was being loaded.
+//
+void FBC_Frame(void)
+{
+    uint32_t now = SDL_GetTicks();
+
+    if(frames++ && now - lastframe < 1000)
+    {
+        timedframes++;
+        timedms += now - lastframe;
+    }
+    lastframe = now;
+}
+
+unsigned FBC_Frames(void)
+{
+    return frames;
+}
+
+//
+// Runs at exit after SDL_Quit, because it is registered before it: the
+// terminal shows text again by now.
+//
+static void FBC_AtExit(void)
+{
+    // The 3D view only.  In play it is held to 70 frames a second, and
+    // demos to 17.5 unless --timedemo plays them.
+    if(timedframes > 0 && timedms > 0)
+    {
+        unsigned tenths = (timedms + 50) / 100;
+        unsigned fps10 = (unsigned) (((uint64_t) timedframes * 10000 + timedms / 2) / timedms);
+        FBC_Note("wolf3d: %u frames of the 3D view, %u.%u s of drawing (%u.%u fps)\n",
+            frames, tenths / 10, tenths % 10, fps10 / 10, fps10 % 10);
+    }
+
+    if(noteslen)
+    {
+        fwrite(notes, 1, noteslen, stdout);
+        fflush(stdout);
+        noteslen = 0;
+    }
+}
+
+void FBC_TextMode(void)
+{
+    if(SDL_WasInit(SDL_INIT_VIDEO))
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+}
+
+/*
+=============================================================================
+
+                            CONSOLE GUARD
+
+=============================================================================
+*/
+
+//
+// The terminal that is on the screen now.  /dev/tty0 is that one for
+// whoever may open it; /dev/tty is the one we were started on.
+//
+static int OpenConsole(int *vt)
+{
+    struct vt_stat  state;
+    int             fd, mode;
+
+    fd = open("/dev/tty0", O_RDWR | O_NOCTTY);
+    if(fd < 0)
+        fd = open("/dev/tty", O_RDWR | O_NOCTTY);
+    if(fd < 0)
+        return -1;
+
+    if(ioctl(fd, KDGKBMODE, &mode) < 0 || ioctl(fd, VT_GETSTATE, &state) < 0)
+    {
+        close(fd);      // not a console
+        return -1;
+    }
+
+    *vt = state.v_active;
+    return fd;
+}
+
+//
+// What the terminal that was on the screen when the game started looked
+// like then.  The game finds this out before it changes anything, and
+// hands it to the guard.
+//
+static struct
+{
+    int             vt;         // -1: not a console
+    int             kbmode;
+    int             haveterm;
+    struct termios  term;
+} start = { -1 };
+
+static void RememberConsole(void)
+{
+    int fd = OpenConsole(&start.vt);
+
+    if(fd < 0)
+    {
+        start.vt = -1;
+        return;
+    }
+    if(ioctl(fd, KDGKBMODE, &start.kbmode) < 0)
+        start.kbmode = K_UNICODE;
+    start.haveterm = tcgetattr(fd, &start.term) == 0;
+    close(fd);
+}
+
+//
+// Puts one terminal right if it is in graphics mode, or its keyboard sends
+// raw codes, or its settings are the ones SDL gives it.  Returns true if
+// there was something to put right.
+//
+static boolean FixTerminal(int fd, int vt)
+{
+    struct termios  term;
+    int             kdmode = KD_TEXT, kbmode = K_UNICODE;
+    boolean         haveterm, rawterm;
+
+    ioctl(fd, KDGETMODE, &kdmode);
+    ioctl(fd, KDGKBMODE, &kbmode);
+    haveterm = tcgetattr(fd, &term) == 0;
+    // SDL's settings: no line editing, no echo, no signals from keys, and
+    // reads that do not wait.  No shell leaves a terminal like that.
+    rawterm = haveterm && !(term.c_lflag & (ICANON | ECHO | ISIG)) && term.c_cc[VMIN] == 0;
+
+    if(kdmode == KD_TEXT && kbmode != K_MEDIUMRAW && kbmode != K_RAW && !rawterm)
+        return false;
+
+    // The keyboard and the terminal settings first, and text mode after:
+    // going back to text mode redraws the screen, which takes a while, and
+    // the shell that was waiting for the game is about to read the settings.
+    if(vt == start.vt && start.haveterm)
+    {
+        ioctl(fd, KDSKBMODE, start.kbmode);
+        tcsetattr(fd, TCSAFLUSH, &start.term);
+    }
+    else
+    {
+        // What this terminal was like before is not known.  Give it the
+        // keyboard mode that the kernel starts terminals in, and undo the
+        // changes that SDL makes to the settings.
+        ioctl(fd, KDSKBMODE, vt == start.vt ? start.kbmode : K_UNICODE);
+        if(haveterm)
+        {
+            term.c_iflag |= ICRNL | IXON;
+            term.c_lflag |= ICANON | ECHO | ISIG;
+            term.c_cc[VMIN] = 1;
+            term.c_cc[VTIME] = 0;
+            tcsetattr(fd, TCSAFLUSH, &term);
+        }
+    }
+    ioctl(fd, KDSETMODE, KD_TEXT);
+    return true;
+}
+
+//
+// Looks at the terminal on the screen, and at the one the game was started
+// on if that is another, and puts right what a game that has gone left
+// behind.  If the game had moved the screen to a terminal of its own, the
+// screen goes back.  Returns true if there was something to put right.
+//
+// Only call this when no game is running: it cannot tell a game that has
+// died from one that is being played.
+//
+static boolean FixConsole(void)
+{
+    char    path[32];
+    boolean fixed, other = false;
+    int     vt, fd, fd2;
+
+    fd = OpenConsole(&vt);
+    if(fd < 0)
+        return false;
+
+    fixed = FixTerminal(fd, vt);
+
+    if(start.vt > 0 && vt != start.vt)
+    {
+        snprintf(path, sizeof(path), "/dev/tty%d", start.vt);
+        fd2 = open(path, O_RDWR | O_NOCTTY);
+        if(fd2 >= 0)
+        {
+            other = FixTerminal(fd2, start.vt);
+            close(fd2);
+        }
+    }
+
+    if(fixed)
+    {
+        ioctl(fd, VT_UNLOCKSWITCH, 1);
+        if(start.vt > 0 && vt != start.vt)
+            ioctl(fd, VT_ACTIVATE, start.vt);
+    }
+
+    close(fd);
+    return fixed || other;
+}
+
+//
+// The guard: started by the game before it touches anything, with one end
+// of a pipe that only the game holds the other end of.  When the game ends,
+// however it ends, the pipe closes and the read below returns.
+//
+static int GuardMain(int pipefd)
+{
+    static const int ignored[] = { SIGINT, SIGTERM, SIGHUP, SIGQUIT, SIGPIPE,
+        SIGALRM, SIGUSR1, SIGUSR2, SIGTTOU, SIGTTIN, SIGTSTP };
+    struct sched_param  param;
+    size_t              i, got = 0;
+    ssize_t             n;
+    char                c;
+
+    // Whatever is sent to the game by name or from the keyboard comes here
+    // too.  This has to outlast the game.
+    for(i = 0; i < lengthof(ignored); i++)
+        signal(ignored[i], SIG_IGN);
+
+    // Hold nothing open but the pipe
+    for(i = 0; i < 3; i++)
+    {
+        if((int) i != pipefd)
+        {
+            close(i);
+            open("/dev/null", O_RDWR);
+        }
+    }
+
+    // When the game dies, the shell that started it wakes up as well, and
+    // one of the first things a shell does is to read the terminal settings
+    // so that it can put them back after each command.  This has to get
+    // there before it does.  A real-time priority sees to that; nothing
+    // else here needs one, and nothing is lost if it is refused.  (The
+    // sched_setscheduler() of the C library does nothing, on purpose.)
+    param.sched_priority = 1;
+    syscall(SYS_sched_setscheduler, 0, SCHED_FIFO, &param);
+
+    // First what the console was like before the game changed it ...
+    while(got < sizeof(start))
+    {
+        n = read(pipefd, (char *) &start + got, sizeof(start) - got);
+        if(n < 0 && errno == EINTR)
+            continue;
+        if(n < 0)
+            return 1;   // not a pipe: started by hand
+        if(n == 0)
+            break;
+        got += n;
+    }
+    if(got < sizeof(start))
+    {
+        // the game went before it had said: go by what can be seen now
+        RememberConsole();
+        start.haveterm = false;
+        start.kbmode = K_UNICODE;
+    }
+    else
+    {
+        // ... and then nothing, until the game has gone
+        while((n = read(pipefd, &c, 1)) != 0)
+        {
+            if(n < 0 && errno != EINTR)
+                return 1;
+        }
+    }
+
+    FixConsole();
+    return 0;
+}
+
+static void StartGuard(void)
+{
+    char    arg[16];
+    int     fds[2];
+    pid_t   pid;
+
+    if(getenv("WOLF3D_NOGUARD"))
+        return;
+
+    RememberConsole();
+    if(start.vt < 0)
+        return;
+
+    if(pipe(fds) < 0)
+        return;
+
+    pid = fork();
+    if(pid == 0)
+    {
+        // A new program rather than a copy of this one, so that it does
+        // not hold on to this one's memory.  /proc/self/exe is this file
+        // whatever it was started as.
+        close(fds[1]);
+        snprintf(arg, sizeof(arg), "%d", fds[0]);
+        execl("/proc/self/exe", "wolf3d-guard", "--console-guard", arg, (char *) NULL);
+        _exit(127);
+    }
+
+    // Tell the guard what the console is like now, and then keep fds[1]
+    // open, and silent, for as long as the game runs.  No message if there
+    // is no guard: the game runs as well without.  (A guard that could not
+    // be started has gone already, and a write to a pipe that nobody reads
+    // is a SIGPIPE: not one to die of.)
+    void (*oldpipe)(int) = signal(SIGPIPE, SIG_IGN);
+
+    close(fds[0]);
+    if(pid < 0 || write(fds[1], &start, sizeof(start)) != (ssize_t) sizeof(start))
+        close(fds[1]);
+    else
+        fcntl(fds[1], F_SETFD, FD_CLOEXEC);
+
+    signal(SIGPIPE, oldpipe);
+}
+
+#if defined(__riscv_zba) || defined(__riscv_zbb) || defined(__riscv_zbs)
+
+// This build is for a processor with bit manipulation instructions.  One
+// without them stops at the first such instruction it meets, and that can be
+// anywhere: the middle of a level, say.  So one instruction of each kind the
+// compiler was allowed is tried before anything else is done, and the game
+// says what is missing in place of "Illegal instruction".  "Before anything
+// else" has to mean before the constructors of the program's static objects,
+// which run ahead of main(): the first such instruction is in one of them.
+// The C library is not built this way, so it and this function's own calls
+// are safe.
+
+#include <setjmp.h>
+
+static sigjmp_buf illjump;
+static const char *volatile trying;
+
+static void IllegalInstruction(int)
+{
+    siglongjmp(illjump, 1);
+}
+
+static void __attribute__((constructor(101))) CheckProcessor(void)
+{
+    struct sigaction act, old;
+    unsigned long one = 1, result;
+
+    memset(&act, 0, sizeof(act));
+    act.sa_handler = IllegalInstruction;
+    sigemptyset(&act.sa_mask);
+    sigaction(SIGILL, &act, &old);
+
+    if(sigsetjmp(illjump, 1))
+    {
+        fprintf(stderr, "wolf3d: this build is for a processor with %s, and this "
+            "one does not have it.\nUse the build without \"zb\" in its name.\n",
+            trying);
+        _exit(1);
+    }
+
+#ifdef __riscv_zba
+    trying = "Zba";
+    __asm__ volatile ("sh1add %0, %1, %1" : "=r" (result) : "r" (one));
+#endif
+#ifdef __riscv_zbb
+    trying = "Zbb";
+    __asm__ volatile ("andn %0, %1, %1" : "=r" (result) : "r" (one));
+#endif
+#ifdef __riscv_zbs
+    trying = "Zbs";
+    __asm__ volatile ("bset %0, %1, %1" : "=r" (result) : "r" (one));
+#endif
+    (void) result;
+
+    sigaction(SIGILL, &old, NULL);
+}
+
+#endif
+
+boolean FBC_Main(int argc, char *argv[], int *status)
+{
+    if(argc == 3 && !strcmp(argv[1], "--console-guard"))
+    {
+        *status = GuardMain(atoi(argv[2]));
+        return true;
+    }
+    if(argc == 2 && !strcmp(argv[1], "--fix-console"))
+    {
+        // Started from a timer, this is a background job on the terminal it
+        // is about to change the settings of, and the kernel stops such a
+        // job with SIGTTOU unless it ignores that
+        signal(SIGTTOU, SIG_IGN);
+        signal(SIGTTIN, SIG_IGN);
+        signal(SIGTSTP, SIG_IGN);
+
+        RememberConsole();
+        // What it was before is not known any more: the kernel's defaults
+        start.kbmode = K_UNICODE;
+        start.haveterm = false;
+        if(start.vt < 0)
+            puts("The screen is not showing a console that this can open.");
+        else if(FixConsole())
+            puts("The console was in graphics mode or had a raw keyboard. It has been put back.");
+        else
+            puts("The console is in text mode with an ordinary keyboard. Nothing to do.");
+        *status = 0;
+        return true;
+    }
+    return false;
+}
+
+void FBC_Startup(void)
+{
+    // Say on stderr which screen, keyboard and mouse SDL found.  This is
+    // printed before the screen is taken over, so it is still there after.
+    setenv("SDL_FBCON_VERBOSE", "1", 0);
+
+    atexit(FBC_AtExit);
+    StartGuard();
+}
+
+#else   // not Linux
+
+boolean FBC_Main(int argc, char *argv[], int *status) { return false; }
+void FBC_Startup(void) {}
+void FBC_TextMode(void) {}
+void FBC_Frame(void) {}
+unsigned FBC_Frames(void) { return 0; }
+
+void FBC_Note(const char *format, ...)
+{
+    va_list vlist;
+
+    va_start(vlist, format);
+    vprintf(format, vlist);
+    va_end(vlist);
+}
+
+#endif
