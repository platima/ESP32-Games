+// WL_FBCON.H
+//
+// Running on the Linux frame buffer console, where the screen the game draws
+// on is also the terminal it was started from.  See wl_fbcon.cpp.
+
+#ifndef __WL_FBCON_H_
+#define __WL_FBCON_H_
+
+// Handles --console-guard and --fix-console, which do their work and are
+// done.  Returns true if it was one of them, with the exit status in *status.
+boolean FBC_Main(int argc, char *argv[], int *status);
+
+// Call once, before SDL_Init and before atexit(SDL_Quit).
+void FBC_Startup(void);
+
+// Keeps a message until the program ends and the terminal shows text again.
+void FBC_Note(const char *format, ...);
+
+// Puts the terminal back in text mode now, so that what is printed next can
+// be read.  Nothing can be drawn after this.
+void FBC_TextMode(void);
+
+// Call when a frame of the 3D view has been put on the screen.
+void FBC_Frame(void);
+
+// The frames counted so far.
+unsigned FBC_Frames(void);
+
+#endif
