diff --git a/id_vp.cpp b/id_vp.cpp
new file mode 100644
index 0000000..7115a46
--- /dev/null
+++ b/id_vp.cpp
@@ -0,0 +1,436 @@
+// ID_VP.CPP
+//
+// Putting the picture on the screen.
+//
+// The game draws into a buffer of its own, one byte a pixel.  It used to hand
+// that to SDL on every frame, which turned all of it into the screen's pixels
+// one at a time, changed or not, and showed it at its own size.  For a screen
+// larger than the original 320x200 that meant drawing the game at a larger
+// size to fill it: four times the pixels at 640x400, and SDL's work on top.
+//
+// Here the game goes on drawing at the size it likes, 320x200 by default,
+// and this enlarges the picture on its way to the screen.  It keeps a copy of
+// what is on the screen now, compares the new picture with it four pixels at
+// a time, and writes only what is different, two screen pixels to a store.
+// On a machine where every store to memory is slow, that is most of the
+// difference between six frames a second and twenty.
+//
+// This is used where the screen has 16 bits a pixel and no second page.
+// Anywhere else, and with --scale off, SDL does it as before.
+
+#include "wl_def.h"
+
+extern SDL_Color curpal[256];
+
+int      vp_mode = VP_WHOLE;
+unsigned vp_screenwidth, vp_screenheight;
+
+static boolean  active;
+static int      dstx, dsty, dstw, dsth;     // where on the screen the picture goes
+
+// Nearest neighbour: the source column and row for each column and row of
+// the picture on the screen, and the other way round, the first column and
+// row on the screen of each source column and row (with one more entry at
+// the end, so that the next entry is always where a source pixel stops).
+static uint16_t *xmap, *ymap;
+static uint16_t *xstart, *ystart;
+
+// What is on the screen now, as the source pixels it was made from
+static byte     *shadow;
+static boolean  shadowvalid;
+
+// The colours as screen pixels, each in both halves of a word
+static uint32_t pal32[256];
+static boolean  paldirty = true;
+
+// Widths that have a row loop of their own
+enum { XP_ANY, XP_1, XP_2, XP_5_2 };
+static int      xpat;
+
+// WOLF3D_CHECK_PRESENT in the environment: after every picture, read the
+// screen back and compare it with the picture, pixel by pixel.  For tests.
+static boolean  selfcheck;
+
+// Four source pixels at a time
+typedef uint32_t __attribute__((may_alias)) word_t;
+
+// Two screen pixels in one store: the first from a, the second from b
+#define PAIR(a, b) (((a) & 0xffff) | ((b) & 0xffff0000))
+
+void VP_ScreenSize(unsigned *width, unsigned *height)
+{
+    const SDL_VideoInfo *info = SDL_GetVideoInfo();
+    unsigned w = vp_screenwidth ? vp_screenwidth : (unsigned) info->current_w;
+    unsigned h = vp_screenheight ? vp_screenheight : (unsigned) info->current_h;
+
+    *width = screenWidth;
+    *height = screenHeight;
+
+    if(vp_mode != VP_OFF && screenBits == 16 && w >= screenWidth && h >= screenHeight)
+    {
+        *width = w;
+        *height = h;
+    }
+}
+
+boolean VP_Active(void)
+{
+    return active;
+}
+
+void VP_PaletteChanged(void)
+{
+    paldirty = true;
+}
+
+static void MakePalette(void)
+{
+    for(int i = 0; i < 256; i++)
+    {
+        uint32_t v = SDL_MapRGB(screen->format, curpal[i].r, curpal[i].g, curpal[i].b) & 0xffff;
+        pal32[i] = v | (v << 16);
+    }
+    paldirty = false;
+}
+
+//
+// Which row loop suits the columns in xmap.  A special one is only chosen
+// when every entry of xmap agrees with it, so that it draws exactly what a
+// loop through xmap would; and only where its stores are aligned.
+//
+static int Pattern(void)
+{
+    int sw = screenWidth;
+    boolean is1 = dstw == sw, is2 = dstw == sw * 2, is5_2 = dstw * 2 == sw * 5;
+
+#if SDL_BYTEORDER != SDL_LIL_ENDIAN
+    return XP_ANY;
+#endif
+    if((sw & 3) || (dstx & 1) || (screen->pitch & 3) || ((uintptr_t) screen->pixels & 3))
+        return XP_ANY;
+
+    for(int i = 0; i < dstw; i++)
+    {
+        if(xmap[i] != i)
+            is1 = false;
+        if(xmap[i] != i / 2)
+            is2 = false;
+        if(xmap[i] != i / 5 * 2 + (i % 5 >= 2))
+            is5_2 = false;
+    }
+    return is1 ? XP_1 : is2 ? XP_2 : is5_2 ? XP_5_2 : XP_ANY;
+}
+
+void VP_Startup(void)
+{
+    int w = screen->w, h = screen->h;
+    int sw = screenWidth, sh = screenHeight;
+    int i, c, f;
+
+    active = false;
+    free(xmap); free(ymap); free(xstart); free(ystart); free(shadow);
+    xmap = ymap = xstart = ystart = NULL;
+    shadow = NULL;
+
+    if(vp_mode == VP_OFF || screen->format->BitsPerPixel != 16
+            || (screen->flags & SDL_DOUBLEBUF) || w < sw || h < sh)
+        return;
+
+    dstw = w;
+    dsth = h;
+    if(vp_mode == VP_ASPECT)
+    {
+        if(w * 3 > h * 4)
+            dstw = h * 4 / 3;
+        else
+            dsth = w * 3 / 4;
+    }
+    if(vp_mode == VP_WHOLE || dstw < sw || dsth < sh)
+    {
+        f = w / sw < h / sh ? w / sw : h / sh;
+        dstw = sw * f;
+        dsth = sh * f;
+    }
+    dstx = ((w - dstw) / 2) & ~1;
+    dsty = (h - dsth) / 2;
+
+    xmap = (uint16_t *) malloc(dstw * sizeof(*xmap));
+    ymap = (uint16_t *) malloc(dsth * sizeof(*ymap));
+    xstart = (uint16_t *) malloc((sw + 1) * sizeof(*xstart));
+    ystart = (uint16_t *) malloc((sh + 1) * sizeof(*ystart));
+    shadow = (byte *) malloc(sw * sh);
+    if(!xmap || !ymap || !xstart || !ystart || !shadow)
+        return;     // SDL can still do it, unscaled
+
+    // The source is sampled at the centre of each pixel of the picture
+    for(i = 0; i < dstw; i++)
+        xmap[i] = ((2 * i + 1) * sw) / (2 * dstw);
+    for(i = 0; i < dsth; i++)
+        ymap[i] = ((2 * i + 1) * sh) / (2 * dsth);
+
+    for(i = 0, c = 0; i < dstw; i++)
+        while(c <= xmap[i])
+            xstart[c++] = i;
+    while(c <= sw)
+        xstart[c++] = dstw;
+    for(i = 0, c = 0; i < dsth; i++)
+        while(c <= ymap[i])
+            ystart[c++] = i;
+    while(c <= sh)
+        ystart[c++] = dsth;
+
+    xpat = Pattern();
+    shadowvalid = false;
+    paldirty = true;
+    selfcheck = getenv("WOLF3D_CHECK_PRESENT") != NULL;
+    active = true;
+
+    FBC_Note("wolf3d: drawn at %dx%d, shown at %dx%d from (%d,%d)\n", sw, sh, dstw, dsth, dstx, dsty);
+}
+
+/*
+=============================================================================
+
+    The row loops.  Each takes one row of the picture and writes it to the
+    n rows of the screen that show it, skipping every four pixels that are
+    on the screen already unless all is set.
+
+=============================================================================
+*/
+
+#define ROW_LOOP static inline __attribute__((always_inline)) void
+
+// Twice the width: each source pixel is one store
+ROW_LOOP Row2(byte *row, int line, int n, const byte *src, byte *shd, int words, boolean all)
+{
+    for(int i = 0; i < words; i++, row += 16)
+    {
+        uint32_t v = ((const word_t *) (const void *) src)[i];
+        if(!all && v == ((const word_t *) (const void *) shd)[i])
+            continue;
+        ((word_t *) (void *) shd)[i] = v;
+
+        uint32_t a = pal32[v & 0xff], b = pal32[(v >> 8) & 0xff];
+        uint32_t c = pal32[(v >> 16) & 0xff], d = pal32[v >> 24];
+        word_t *o = (word_t *) (void *) row;
+        int k = n;
+        do
+        {
+            o[0] = a; o[1] = b; o[2] = c; o[3] = d;
+            o = (word_t *) (void *) ((byte *) o + line);
+        } while(--k);
+    }
+}
+
+// Two and a half times the width (320 to 800): the source pixels a b c d
+// become a a b b b c c d d d, which is five stores
+ROW_LOOP Row5_2(byte *row, int line, int n, const byte *src, byte *shd, int words, boolean all)
+{
+    for(int i = 0; i < words; i++, row += 20)
+    {
+        uint32_t v = ((const word_t *) (const void *) src)[i];
+        if(!all && v == ((const word_t *) (const void *) shd)[i])
+            continue;
+        ((word_t *) (void *) shd)[i] = v;
+
+        uint32_t a = pal32[v & 0xff], b = pal32[(v >> 8) & 0xff];
+        uint32_t c = pal32[(v >> 16) & 0xff], d = pal32[v >> 24];
+        uint32_t bc = PAIR(b, c), cd = PAIR(c, d);
+        word_t *o = (word_t *) (void *) row;
+        int k = n;
+        do
+        {
+            o[0] = a; o[1] = b; o[2] = bc; o[3] = cd; o[4] = d;
+            o = (word_t *) (void *) ((byte *) o + line);
+        } while(--k);
+    }
+}
+
+// The same width: two source pixels to a store
+ROW_LOOP Row1(byte *row, int line, int n, const byte *src, byte *shd, int words, boolean all)
+{
+    for(int i = 0; i < words; i++, row += 8)
+    {
+        uint32_t v = ((const word_t *) (const void *) src)[i];
+        if(!all && v == ((const word_t *) (const void *) shd)[i])
+            continue;
+        ((word_t *) (void *) shd)[i] = v;
+
+        uint32_t ab = PAIR(pal32[v & 0xff], pal32[(v >> 8) & 0xff]);
+        uint32_t cd = PAIR(pal32[(v >> 16) & 0xff], pal32[v >> 24]);
+        word_t *o = (word_t *) (void *) row;
+        int k = n;
+        do
+        {
+            o[0] = ab; o[1] = cd;
+            o = (word_t *) (void *) ((byte *) o + line);
+        } while(--k);
+    }
+}
+
+// Any width, through xmap, a row at a time and a pixel to a store
+static void RowAny(byte *row, int line, int n, const byte *src, byte *shd, boolean all)
+{
+    if(!all && !memcmp(src, shd, screenWidth))
+        return;
+    memcpy(shd, src, screenWidth);
+
+    for(; n > 0; n--, row += line)
+    {
+        uint16_t *o = (uint16_t *) (void *) row;
+        for(int x = 0; x < dstw; x++)
+            o[x] = (uint16_t) pal32[src[xmap[x]]];
+    }
+}
+
+//
+// Reads the screen back and compares it with the picture
+//
+static void Check(SDL_Surface *source)
+{
+    const byte *src = VL_LockSurface(source);
+    const byte *dst = VL_LockSurface(screen);
+    int badx = -1, bady = -1;
+    uint16_t want[256];
+
+    // the screen cannot be had while it is on another terminal
+    if(src == NULL || dst == NULL)
+    {
+        if(dst != NULL)
+            VL_UnlockSurface(screen);
+        if(src != NULL)
+            VL_UnlockSurface(source);
+        return;
+    }
+
+    // from the colours as they are, not from the table the picture was
+    // drawn with
+    for(int i = 0; i < 256; i++)
+        want[i] = (uint16_t) SDL_MapRGB(screen->format, curpal[i].r, curpal[i].g, curpal[i].b);
+
+    for(int y = 0; y < dsth && badx < 0; y++)
+    {
+        const byte *s = src + ymap[y] * source->pitch;
+        const uint16_t *o = (const uint16_t *) (const void *) (dst + (dsty + y) * screen->pitch) + dstx;
+        for(int x = 0; x < dstw; x++)
+        {
+            if(o[x] != want[s[xmap[x]]])
+            {
+                badx = x;
+                bady = y;
+                break;
+            }
+        }
+    }
+    for(int y = 0; y < (int) screenHeight && badx < 0; y++)
+    {
+        if(memcmp(src + y * source->pitch, shadow + y * screenWidth, screenWidth))
+        {
+            badx = 0;
+            bady = ystart[y];
+        }
+    }
+    VL_UnlockSurface(screen);
+    VL_UnlockSurface(source);
+
+    if(badx >= 0)
+        Quit("VP_Check: the screen is not the picture at (%d,%d)", dstx + badx, dsty + bady);
+}
+
+void VP_Present(SDL_Surface *source)
+{
+    if(!active)
+    {
+        SDL_BlitSurface(source, NULL, screen, NULL);
+        SDL_Flip(screen);
+        return;
+    }
+
+    const byte *src = VL_LockSurface(source);
+    byte *dst = VL_LockSurface(screen);
+
+    if(src != NULL && dst != NULL)
+    {
+        const int line = screen->pitch, spitch = source->pitch;
+        const int sw = screenWidth, sh = screenHeight, words = sw / 4;
+        // the row loops read the picture four pixels at a time
+        const int pat = (((uintptr_t) src | spitch) & 3) ? XP_ANY : xpat;
+        boolean all = !shadowvalid;
+        byte *shd = shadow;
+
+        if(paldirty)
+        {
+            MakePalette();
+            all = true;
+        }
+
+        dst += dsty * line + dstx * 2;
+
+        for(int y = 0; y < sh; y++, src += spitch, shd += sw)
+        {
+            int n = ystart[y + 1] - ystart[y];
+            byte *row = dst + ystart[y] * line;
+
+            // n is small, and a constant where it matters: that takes the
+            // loop over the rows out of the loop over the pixels
+            if(n <= 0)
+                continue;
+            if(pat == XP_2)
+            {
+                if(n == 2) Row2(row, line, 2, src, shd, words, all);
+                else if(n == 3) Row2(row, line, 3, src, shd, words, all);
+                else Row2(row, line, n, src, shd, words, all);
+            }
+            else if(pat == XP_5_2)
+            {
+                if(n == 2) Row5_2(row, line, 2, src, shd, words, all);
+                else if(n == 3) Row5_2(row, line, 3, src, shd, words, all);
+                else Row5_2(row, line, n, src, shd, words, all);
+            }
+            else if(pat == XP_1)
+                Row1(row, line, n, src, shd, words, all);
+            else
+                RowAny(row, line, n, src, shd, all);
+        }
+        shadowvalid = true;
+    }
+
+    if(dst != NULL)
+        VL_UnlockSurface(screen);
+    if(src != NULL)
+        VL_UnlockSurface(source);
+
+    SDL_Flip(screen);
+
+    if(selfcheck)
+        Check(source);
+}
+
+//
+// The fizzle fade draws with the colours of now over a screen that may have
+// been drawn with others, a faded one for instance.  So the colours are
+// made here, and the picture that ends the fade is drawn in full.
+//
+void VP_FizzleStart(void)
+{
+    if(active && paldirty)
+    {
+        MakePalette();
+        shadowvalid = false;
+    }
+}
+
+void VP_Pixel(byte *dest, int x, int y, byte col)
+{
+    uint16_t v = (uint16_t) pal32[col];
+    int x0 = xstart[x], x1 = xstart[x + 1];
+
+    shadow[y * screenWidth + x] = col;
+
+    for(int r = ystart[y]; r < ystart[y + 1]; r++)
+    {
+        uint16_t *o = (uint16_t *) (void *) (dest + (dsty + r) * screen->pitch) + dstx;
+        for(int c = x0; c < x1; c++)
+            o[c] = v;
+    }
+}
