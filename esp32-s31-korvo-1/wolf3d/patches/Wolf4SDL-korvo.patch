+// ID_VP.H
+//
+// Putting the picture on the screen: see id_vp.cpp.
+
+#ifndef __ID_VP_H_
+#define __ID_VP_H_
+
+enum
+{
+    VP_OFF,         // SDL does it, as before: one pixel for one, in the middle
+    VP_WHOLE,       // enlarged by the largest whole number that fits, in the middle
+    VP_FILL,        // stretched to the whole screen
+    VP_ASPECT       // the largest picture of four by three that fits
+};
+
+extern int      vp_mode;                            // --scale
+extern unsigned vp_screenwidth, vp_screenheight;    // --screen; 0: ask SDL
+
+// The size to ask SDL_SetVideoMode for: the screen's own, or the picture's
+// where it is not going to be enlarged.
+void    VP_ScreenSize(unsigned *width, unsigned *height);
+
+// Call when the video mode has been set.
+void    VP_Startup(void);
+
+// The picture goes to the screen through here, not through SDL's blit.
+boolean VP_Active(void);
+
+// Call when the colours have changed.  The next VP_Present draws everything.
+void    VP_PaletteChanged(void);
+
+// Puts the picture on the screen.  Takes the place of SDL_BlitSurface from
+// the picture to the screen followed by SDL_Flip.
+void    VP_Present(SDL_Surface *source);
+
+// For the fizzle fade, which puts the picture on the screen a pixel at a
+// time.  VP_FizzleStart before the first, with nothing locked; then
+// VP_Pixel for each, with the screen locked and dest the address
+// VL_LockSurface gave for it; and VP_Present when it is over.
+void    VP_FizzleStart(void);
+void    VP_Pixel(byte *dest, int x, int y, byte col);
+
+#endif
