+/* Says what the driver found, on stderr, if SDL_FBCON_VERBOSE is set to
+   anything but nothing or 0.  Only called while the console is still in
+   text mode. */
+void FB_Verbose(const char *fmt, ...)
+{
+	const char *verbose = SDL_getenv("SDL_FBCON_VERBOSE");
+	va_list ap;
+
+	if ( (verbose == NULL) || (*verbose == '\0') || (*verbose == '0') ) {
+		return;
+	}
+	fputs("SDL fbcon: ", stderr);
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+	fputc('\n', stderr);
+}
+
 int FB_InGraphicsMode(_THIS)
 {
 	return((keyboard_fd >= 0) && (saved_kbd_mode >= 0));
 }
 
+/* While the console is in graphics mode it shows no text, and the keyboard
+   sends raw codes that no shell can read.  FB_LeaveGraphicsMode() puts that
+   right, but only a program that ends through SDL_Quit() gets there.  One
+   that is ended by a signal, or that calls exit() without SDL_Quit(), would
+   leave a terminal that takes a reboot to get back when there is no other
+   way in.  So for as long as the console is in graphics mode, the signals
+   that end a program by default are caught: the console is put back, and
+   then the signal is left to do what it does.  exit() is covered by an
+   atexit() function.
+
+   This takes the place of SDL's parachute for those signals, which calls
+   SDL_Quit() from the signal handler; that can wait for ever on a lock the
+   interrupted code holds.  It also means that SIGINT and SIGTERM end the
+   program at once here, where SDL would only post an SDL_QUIT event that
+   a program which has stopped reading events never sees.
+
+   Nothing below makes anything but system calls, so it is safe to run
+   from a signal handler. */
+static const int fb_fatal_signals[] = {
+	SIGSEGV, SIGBUS, SIGILL, SIGFPE, SIGABRT, SIGTERM, SIGHUP,
+	SIGINT, SIGQUIT, SIGPIPE, SIGALRM, SIGUSR1, SIGUSR2
+};
+#define FB_NUM_FATAL_SIGNALS	SDL_arraysize(fb_fatal_signals)
+
+static SDL_VideoDevice *fb_console_dev = NULL;	/* whose console is in graphics mode */
+static struct sigaction fb_old_actions[FB_NUM_FATAL_SIGNALS];
+static int fb_signals_caught = 0;
+static int fb_atexit_registered = 0;
+/* A stack for the handler, so that it can still run when the signal came
+   from the stack running out. */
+static char fb_signal_stack[16384];
+
+/* Open a virtual terminal by its number, without a library call that a
+   signal handler may not make. */
+static int FB_ReopenVT(int vt)
+{
+	char path[16] = "/dev/tty";
+	int n = 8;
+
+	if ( (vt < 1) || (vt > 63) ) {
+		vt = 0;		/* the one on the screen */
+	}
+	if ( vt >= 10 ) {
+		path[n++] = (char)('0' + vt / 10);
+	}
+	path[n++] = (char)('0' + vt % 10);
+	path[n] = '\0';
+	return open(path, O_RDWR | O_NOCTTY, 0);
+}
+
+static void FB_RestoreConsole(_THIS)
+{
+	if ( FB_InGraphicsMode(this) ) {
+		int fd = keyboard_fd;
+		int fresh = -1;
+
+		/* After a hangup (the shell that owned the terminal has gone,
+		   say) nothing can be done through a descriptor that was open
+		   at the time: every call fails with EIO.  The terminal is
+		   still in graphics mode.  Open it again and go on with that. */
+		if ( (ioctl(fd, KDSETMODE, KD_TEXT) < 0) && (errno == EIO) ) {
+			fresh = FB_ReopenVT(current_vt);
+			if ( fresh >= 0 ) {
+				fd = fresh;
+				ioctl(fd, KDSETMODE, KD_TEXT);
+			}
+		}
+		ioctl(fd, KDSKBMODE, saved_kbd_mode);
+		/* TCSAFLUSH also throws away the raw key codes that were
+		   never read, which the shell would take for typing. */
+		tcsetattr(fd, TCSAFLUSH, &saved_kbd_termios);
+		saved_kbd_mode = -1;
+
+		/* Head back over to the original virtual terminal */
+		ioctl(fd, VT_UNLOCKSWITCH, 1);
+		if ( saved_vt > 0 ) {
+			ioctl(fd, VT_ACTIVATE, saved_vt);
+		}
+		if ( fresh >= 0 ) {
+			close(fresh);
+		}
+	}
+}
+
+static void FB_FatalSignal(int sig)
+{
+	struct sigaction action;
+
+	if ( fb_console_dev != NULL ) {
+		FB_RestoreConsole(fb_console_dev);
+	}
+
+	/* Now let the signal end the program in the usual way.  It is
+	   blocked while we are in here, and arrives when we return. */
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = SIG_DFL;
+	sigaction(sig, &action, NULL);
+	raise(sig);
+}
+
+static void FB_AtExit(void)
+{
+	if ( fb_console_dev != NULL ) {
+		FB_RestoreConsole(fb_console_dev);
+	}
+}
+
+static void FB_CatchSignals(_THIS)
+{
+	struct sigaction action;
+	stack_t stack;
+	int i;
+
+	fb_console_dev = this;
+
+	if ( !fb_atexit_registered ) {
+		fb_atexit_registered = (atexit(FB_AtExit) == 0);
+	}
+	if ( fb_signals_caught ) {
+		return;
+	}
+
+	memset(&stack, 0, sizeof(stack));
+	stack.ss_sp = fb_signal_stack;
