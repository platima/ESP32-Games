+#include "SDL_config.h"
+
+/* Mice read from the kernel's event devices, /dev/input/eventN.
+
+   The rest of this driver wants a device that speaks a mouse protocol:
+   gpm, /dev/input/mice, /dev/psaux.  The last two come from the kernel's
+   mousedev driver, and a kernel built without it (CONFIG_INPUT_MOUSEDEV)
+   has only the event devices.  Up to FB_MAX_MICE of them are read here,
+   and what they report is handed to FB_vgamousecallback() like the
+   packets of any other mouse.  This file is not part of SDL 1.2.15. */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <linux/input.h>
+
+#include "SDL_stdinc.h"
+#include "SDL_fbvideo.h"
+#include "SDL_fbevents_c.h"
+
+#define FB_MAX_MICE	4
+#define FB_MAX_EVDEV	32	/* event0 to event31 are looked at */
+
+/* SDL adds movement to the position of the pointer in 16 bits.  This is
+   far more than a mouse sends between two calls, and small enough for the
+   sum to stay in range on any screen, whatever a device reports. */
+#define FB_MOUSE_MAX	0x3fff
+
+/* The buttons as FB_vgamousecallback() wants them */
+#define FB_BUTTON_LEFT		0x04
+#define FB_BUTTON_MIDDLE	0x02
+#define FB_BUTTON_RIGHT		0x01
+#define FB_BUTTON_WHEELUP	0x08
+#define FB_BUTTON_WHEELDOWN	0x10
+
+/* An event as the kernel writes it: the time as two longs, then the type,
+   the code and the value.  struct input_event from <linux/input.h> is not
+   used for reading: where time_t is 64 bits and long is 32, it only has
+   this size if the C library says so in the way that header expects. */
+struct fb_input_event {
+	unsigned long sec;
+	unsigned long usec;
+	Uint16 type;
+	Uint16 code;
+	Sint32 value;
+};
+typedef char fb_input_event_size_check
+	[(sizeof(struct fb_input_event) == (sizeof(long) == 4 ? 16 : 24)) ? 1 : -1];
+
+static struct fb_mouse {
+	int fd;
+	int buttons;	/* FB_BUTTON_LEFT, _MIDDLE and _RIGHT that are down */
+	int have;	/* bytes of an unfinished event left by the last read */
+	unsigned char buf[16 * sizeof(struct fb_input_event)];
+} fb_mice[FB_MAX_MICE];
+
+static int fb_nmice = 0;
+
+/* The kernel's bitmaps are arrays of unsigned long */
+#define FB_LONG_BITS		(8 * sizeof(unsigned long))
+#define FB_BITMAP_LONGS(n)	(((n) + FB_LONG_BITS - 1) / FB_LONG_BITS)
+
+static int fb_test_bit(const unsigned long *map, int n)
+{
+	return (int)((map[n / FB_LONG_BITS] >> (n % FB_LONG_BITS)) & 1);
+}
+
+/* A mouse reports relative X and Y and has a left button */
+static int fb_is_mouse(int fd)
+{
+	unsigned long ev[FB_BITMAP_LONGS(EV_CNT)];
+	unsigned long rel[FB_BITMAP_LONGS(REL_CNT)];
+	unsigned long key[FB_BITMAP_LONGS(KEY_CNT)];
+
+	memset(ev, 0, sizeof(ev));
+	memset(rel, 0, sizeof(rel));
+	memset(key, 0, sizeof(key));
+
+	if ( (ioctl(fd, EVIOCGBIT(0, sizeof(ev)), ev) < 0) ||
+	     !fb_test_bit(ev, EV_REL) || !fb_test_bit(ev, EV_KEY) ) {
+		return 0;
+	}
+	if ( (ioctl(fd, EVIOCGBIT(EV_REL, sizeof(rel)), rel) < 0) ||
+	     (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(key)), key) < 0) ) {
+		return 0;
+	}
+	return fb_test_bit(rel, REL_X) && fb_test_bit(rel, REL_Y) &&
+	       fb_test_bit(key, BTN_LEFT);
+}
+
+/* Find the mice.  Returns the descriptor of the first one, or -1. */
+int FB_EvdevOpenMice(void)
+{
+	char path[32];
+	char name[64];
+	int i, fd;
+
+	FB_EvdevCloseMice();
+
+	for ( i=0; (i < FB_MAX_EVDEV) && (fb_nmice < FB_MAX_MICE); ++i ) {
+		SDL_snprintf(path, SDL_arraysize(path), "/dev/input/event%d", i);
+		fd = open(path, O_RDONLY | O_NONBLOCK, 0);
+		if ( fd < 0 ) {
+			continue;
+		}
+		if ( !fb_is_mouse(fd) ) {
+			close(fd);
+			continue;
+		}
+
+		memset(name, 0, sizeof(name));
+		if ( ioctl(fd, EVIOCGNAME(sizeof(name) - 1), name) < 0 ) {
+			SDL_strlcpy(name, "?", sizeof(name));
+		}
+		FB_Verbose("mouse on %s (%s)", path, name);
+
+		fb_mice[fb_nmice].fd = fd;
+		fb_mice[fb_nmice].buttons = 0;
+		fb_mice[fb_nmice].have = 0;
+		++fb_nmice;
+	}
+	return (fb_nmice > 0) ? fb_mice[0].fd : -1;
+}
+
+void FB_EvdevCloseMice(void)
+{
+	while ( fb_nmice > 0 ) {
+		close(fb_mice[--fb_nmice].fd);
+	}
+}
+
+/* The buttons that are down on any of the mice */
+static int fb_all_buttons(void)
+{
+	int i, buttons = 0;
+
+	for ( i=0; i<fb_nmice; ++i ) {
+		buttons |= fb_mice[i].buttons;
+	}
+	return buttons;
+}
+
+/* Add to a movement total, staying within FB_MOUSE_MAX either way */
+static int fb_mouse_move(int total, int value)
+{
+	if ( value > FB_MOUSE_MAX ) {
+		value = FB_MOUSE_MAX;
+	} else if ( value < -FB_MOUSE_MAX ) {
+		value = -FB_MOUSE_MAX;
+	}
+	total += value;
+	if ( total > FB_MOUSE_MAX ) {
+		total = FB_MOUSE_MAX;
+	} else if ( total < -FB_MOUSE_MAX ) {
+		total = -FB_MOUSE_MAX;
+	}
+	return total;
+}
+
+/* Pass on the movement that has been added up, if there is any */
+static void fb_mouse_flush(int *dx, int *dy)
+{
+	if ( *dx || *dy ) {
+		FB_vgamousecallback(fb_all_buttons(), 1, *dx, *dy);
+		*dx = *dy = 0;
+	}
+}
+
+/* The kernel dropped events, so a button change may be missing: ask which
+   buttons are down now. */
+static void fb_mouse_sync(struct fb_mouse *m)
+{
+	unsigned long key[FB_BITMAP_LONGS(KEY_CNT)];
+
+	memset(key, 0, sizeof(key));
+	m->buttons = 0;
+	if ( ioctl(m->fd, EVIOCGKEY(sizeof(key)), key) >= 0 ) {
+		if ( fb_test_bit(key, BTN_LEFT) ) {
+			m->buttons |= FB_BUTTON_LEFT;
+		}
+		if ( fb_test_bit(key, BTN_MIDDLE) ) {
+			m->buttons |= FB_BUTTON_MIDDLE;
+		}
+		if ( fb_test_bit(key, BTN_RIGHT) ) {
+			m->buttons |= FB_BUTTON_RIGHT;
+		}
+	}
+}
+
+static void fb_mouse_event(struct fb_mouse *m, const struct fb_input_event *ev,
+                           int *dx, int *dy)
+{
+	int bit;
+
+	if ( ev->type == EV_REL ) {
+		if ( ev->code == REL_X ) {
+			*dx = fb_mouse_move(*dx, ev->value);
+		} else if ( ev->code == REL_Y ) {
+			*dy = fb_mouse_move(*dy, ev->value);
+		} else if ( (ev->code == REL_WHEEL) && (ev->value != 0) ) {
+			/* One turn of the wheel is a button that goes down
+			   and comes up again, as for an IMPS/2 mouse */
+			fb_mouse_flush(dx, dy);
+			bit = (ev->value > 0) ? FB_BUTTON_WHEELUP : FB_BUTTON_WHEELDOWN;
+			FB_vgamousecallback(fb_all_buttons() | bit, 1, 0, 0);
+			FB_vgamousecallback(fb_all_buttons(), 1, 0, 0);
+		}
+	} else if ( ev->type == EV_KEY ) {
+		switch ( ev->code ) {
+		    case BTN_LEFT:   bit = FB_BUTTON_LEFT;   break;
+		    case BTN_MIDDLE: bit = FB_BUTTON_MIDDLE; break;
+		    case BTN_RIGHT:  bit = FB_BUTTON_RIGHT;  break;
+		    default: return;
+		}
+		/* Movement from before the button changed goes first */
+		fb_mouse_flush(dx, dy);
+		if ( ev->value ) {
+			m->buttons |= bit;
+		} else {
+			m->buttons &= ~bit;
+		}
+		FB_vgamousecallback(fb_all_buttons(), 1, 0, 0);
+	} else if ( (ev->type == EV_SYN) && (ev->code == SYN_DROPPED) ) {
+		fb_mouse_flush(dx, dy);
+		fb_mouse_sync(m);
+		FB_vgamousecallback(fb_all_buttons(), 1, 0, 0);
+	}
+}
+
+/* Read everything that is waiting on one mouse, without blocking.
+   Returns 0 if the mouse has gone (unplugged, for example). */
+static int fb_mouse_drain(struct fb_mouse *m)
+{
+	struct fb_input_event ev;
+	int dx = 0, dy = 0;
+	int n, off, room;
+	int alive = 1;
+
+	for ( ; ; ) {
+		room = (int)sizeof(m->buf) - m->have;
+		n = (int)read(m->fd, m->buf + m->have, room);
+		if ( (n < 0) && (errno == EINTR) ) {
+			continue;
+		}
+		if ( (n < 0) && (errno == EAGAIN) ) {
+			break;
+		}
+		if ( n <= 0 ) {
+			alive = 0;
+			break;
+		}
+
+		/* Handle the whole events, and keep the start of an
+		   unfinished one for the next read */
+		m->have += n;
+		for ( off = 0; off + (int)sizeof(ev) <= m->have; off += (int)sizeof(ev) ) {
+			memcpy(&ev, m->buf + off, sizeof(ev));
+			fb_mouse_event(m, &ev, &dx, &dy);
+		}
+		m->have -= off;
+		memmove(m->buf, m->buf + off, m->have);
+
+		/* A read that did not fill the buffer took all there was */
+		if ( n < room ) {
+			break;
+		}
+	}
+	fb_mouse_flush(&dx, &dy);
+	return alive;
+}
+
+/* Read what is waiting on every mouse.  One that has gone is dropped, and
+   its buttons are let go. */
+void FB_EvdevPumpMice(void)
+{
+	int i;
+
+	for ( i=0; i<fb_nmice; ++i ) {
+		if ( !fb_mouse_drain(&fb_mice[i]) ) {
+			close(fb_mice[i].fd);
+			fb_mice[i] = fb_mice[--fb_nmice];
+			--i;
+			FB_vgamousecallback(fb_all_buttons(), 1, 0, 0);
+		}
+	}
+}
