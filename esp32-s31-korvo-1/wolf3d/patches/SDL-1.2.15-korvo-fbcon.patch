+/* Some frame buffers have one mode and cannot change it: simplefb and efifb,
+   which only show what the firmware set up, are two.  The kernel takes any
+   FBIOPUT_VSCREENINFO for them without complaint and answers with the mode
+   they have.  Ask for a size that is not the current one: if the current
+   one comes back, it is the only mode there is.
+
+   Without this, the search below finds the same thing after some sixty
+   requests.  That is not just slow.  While the console is in text mode,
+   the kernel redraws all of it after every request that succeeds. */
+static int FB_FixedMode(_THIS, const struct fb_var_screeninfo *current)
+{
+	struct fb_var_screeninfo vinfo = *current;
+
+	vinfo.xres = (current->xres == 640) ? 800 : 640;
+	vinfo.yres = (current->yres == 480) ? 600 : 480;
+	vinfo.xres_virtual = vinfo.xres;
+	vinfo.yres_virtual = vinfo.yres;
+	vinfo.activate = FB_ACTIVATE_TEST;
+	if ( ioctl(console_fd, FBIOPUT_VSCREENINFO, &vinfo) < 0 ) {
+		return(0);
+	}
+	return((vinfo.xres == current->xres) && (vinfo.yres == current->yres) &&
+	       (vinfo.bits_per_pixel == current->bits_per_pixel));
+}
