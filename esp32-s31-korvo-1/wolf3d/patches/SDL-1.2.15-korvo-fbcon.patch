+/* If the program was started on a virtual terminal, open that terminal and
+   say which one it is.  Returns the descriptor, or -1. */
+static int FB_OpenOwnVT(int *vt)
+{
+	unsigned int dev = 0;
+	int fd, mode;
+
+	fd = open("/dev/tty", O_RDWR, 0);
+	if ( fd < 0 ) {
+		return(-1);
+	}
+	/* A console answers KDGKBMODE; TIOCGDEV gives its real device
+	   number, which is major 4 and the terminal's number. */
+	if ( (ioctl(fd, KDGKBMODE, &mode) == 0) &&
+	     (ioctl(fd, TIOCGDEV, &dev) == 0) &&
+	     ((dev >> 8) == 4) && ((dev & 0xff) >= 1) && ((dev & 0xff) <= 63) ) {
+		*vt = (int)(dev & 0xff);
+		return(fd);
+	}
+	close(fd);
+	return(-1);
+}
